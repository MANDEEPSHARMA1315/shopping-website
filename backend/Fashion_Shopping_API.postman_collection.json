				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alice Fashion\",\n  \"email\": \"alice@fashion.com\",\n  \"password\": \"alice123\",\n  \"phone\": \"9876543210\",\n  \"address\": \"10 West End Avenue, Mumbai\",\n  \"role\": \"user\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/auth/register",
